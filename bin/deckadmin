#!/usr/bin/env -S jennifer run
# SPDX-License-Identifier: LGPL-3.0-only
# SPDX-FileCopyrightText: Copyright (C) 2026 mplx <jennifer@mplx.dev>
# pragma-jennifer-version: >=0.25.0
#
# deckadmin: the registry's operator CLI. A thin entry point over the `admin`
# module, which holds the grammar, the logic and its tests. The store path
# defaults to data/decks.json (REGISTRY_DB). Run from the repo root:
#
#     jennifer run bin/deckadmin add @acme/tool 1.3.0 <url> --ref v1.3.0 --commit <sha>
#     jennifer run bin/deckadmin list
#     jennifer run bin/deckadmin --help
#
# The command handlers below are one-line shims kept here, not in `admin`:
# `args.dispatch` passes only the parsed result, so they take the store and
# timestamp from program scope (a module top level is declarations-only). A
# `func` value keeps its home context, so each shim resolves these globals.

use os;
use io;
use maps;
use time;
use convert;
import "flatdb.j" as flatdb;
import "args.j" as args;
import "../src/store.j" as store;
import "../src/admin.j" as admin;
import "../src/audit.j" as audit;
import "../src/config.j" as config;

# Read through `config.readEnv` so the deprecated `JVC_*` names work here as they
# do in the server.
def env as config.EnvRead init config.readEnv([
    "REGISTRY_DB",
    "REGISTRY_LOG",
    "REGISTRY_LOG_LEVEL",
    "REGISTRY_LOG_FORMAT"
]);
for (def old in $env.deprecated) {
    io.eprintf("warning: %s is deprecated and will stop being read\n", $old);
}

def dbPath as string init "data/decks.json";
if (maps.has($env.values, "REGISTRY_DB")) {
    $dbPath = $env.values["REGISTRY_DB"];
}

# Opened under the lock below; a copy read here would be stale by then.
def db as flatdb.DB;
def now as string init convert.toString(time.unix(time.utc()));

# envOr reads a collected variable, or "" when it was not set.
func envOr(values as map of string to string, name as string) {
    if (maps.has($values, $name)) {
        return $values[$name];
    }
    return "";
}

/**
 * The `add` / `update` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onAdd(r as args.Result) {
    return admin.cmdAdd($db, $r, $now);
}

/**
 * The `remove` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onRemove(r as args.Result) {
    return admin.cmdRemove($db, $r, $now);
}

/**
 * The `list` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onList(r as args.Result) {
    return admin.cmdList($db, $r, $now);
}

/**
 * The `register-namespace` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onRegisterNamespace(r as args.Result) {
    return admin.cmdRegisterNamespace($db, $r, $now);
}

/**
 * The `add-owner` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onAddOwner(r as args.Result) {
    return admin.cmdAddOwner($db, $r, $now);
}

/**
 * The `remove-owner` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onRemoveOwner(r as args.Result) {
    return admin.cmdRemoveOwner($db, $r, $now);
}

/**
 * The `namespaces` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onNamespaces(r as args.Result) {
    return admin.cmdNamespaces($db, $r, $now);
}

/**
 * The `reserve-defaults` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onReserveDefaults(r as args.Result) {
    return admin.cmdReserveDefaults($db, $r, $now);
}

/**
 * The `mint-token` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onMintToken(r as args.Result) {
    return admin.cmdMintToken($db, $r, $now);
}

/**
 * The `tokens` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onTokens(r as args.Result) {
    return admin.cmdTokens($db, $r, $now);
}

/**
 * The `revoke-token` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onRevokeToken(r as args.Result) {
    return admin.cmdRevokeToken($db, $r, $now);
}

/**
 * The `yank` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onYank(r as args.Result) {
    return admin.cmdSetYanked($db, $r, $now, true);
}

/**
 * The `unyank` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onUnyank(r as args.Result) {
    return admin.cmdSetYanked($db, $r, $now, false);
}

/**
 * The `trust` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onTrust(r as args.Result) {
    return admin.cmdTrust($db, $r, $now);
}

/**
 * The `untrust` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onUntrust(r as args.Result) {
    return admin.cmdUntrust($db, $r, $now);
}

/**
 * The `publishers` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onPublishers(r as args.Result) {
    return admin.cmdPublishers($db, $r, $now);
}

/**
 * The `revoke` handler.
 * @param r {args.Result} the parsed command line
 * @return {admin.AdminResult} the outcome
 */
func onRevoke(r as args.Result) {
    return admin.cmdRevoke($db, $r, $now);
}

# A parse failure (unknown flag, missing positional, bad value) throws and is
# reported like any other failure.
def parsed as args.Result;
try {
    $parsed = admin.parse(os.ARGS);
} catch (err) {
    io.printf("%s\n", $err.message);
    exit 1;
}

# -h / --help sets `done` with the generated usage; nothing to dispatch.
if ($parsed.done) {
    io.printf("%s\n", $parsed.helpText);
    exit 0;
}

if ($parsed.command == "") {
    io.printf("%s\n", args.usage(admin.parser()));
    exit 1;
}

# The operational log. Opened after parsing, since flags configure it, and before
# dispatch, so a failed command is still recorded. An unwritable log path only
# warns.
def logCfg as admin.LogOptions init admin.logOptions(
    $parsed,
    envOr($env.values, "REGISTRY_LOG"),
    envOr($env.values, "REGISTRY_LOG_LEVEL"),
    envOr($env.values, "REGISTRY_LOG_FORMAT"));
def sink as audit.Sink init audit.open(
    $logCfg.level,
    $logCfg.format,
    $logCfg.path,
    $logCfg.console);
if (not ($sink.fileError == "")) {
    io.eprintf("warning: not logging to %s (%s)\n", $logCfg.path, $sink.fileError);
}

# `keywords` is answered before the lock: it reads a compiled-in word list and
# no registry, so it needs neither the lock nor a writable data directory.
if ($parsed.command == "keywords") {
    def listing as admin.AdminResult init admin.cmdKeywords($db, $parsed, $now);
    io.printf("%s\n", $listing.message);
    exit 0;
}

# The write lock covers the read and the write: `flatdb` does not lock, so
# concurrent writers (other runs, or the server) would each overwrite the
# other's edit. Without it, six concurrent adds left one deck.
#
# The store is re-opened inside the lock, since the copy read at startup may be
# stale.
#
# `defer` at top level runs at exit, including `exit 1` and an uncaught throw, so
# a failing command still releases the lock.
def lockHeld as store.Lock init store.lock($dbPath);
defer store.unlock($lockHeld);
$db = store.open($dbPath);

def result as admin.AdminResult init args.dispatch(
    $parsed,
    {
        "add": onAdd,
        "update": onAdd,
        "remove": onRemove,
        "list": onList,
        "register-namespace": onRegisterNamespace,
        "add-owner": onAddOwner,
        "remove-owner": onRemoveOwner,
        "namespaces": onNamespaces,
        "reserve-defaults": onReserveDefaults,
        "mint-token": onMintToken,
        "tokens": onTokens,
        "revoke-token": onRevokeToken,
        "yank": onYank,
        "unyank": onUnyank,
        "trust": onTrust,
        "untrust": onUntrust,
        "publishers": onPublishers,
        "revoke": onRevoke
    });

# Save before logging: a crash in between under-reports a change rather than
# logging one that did not happen.
if ($result.changed) {
    store.save($result.db);
}
audit.write($sink, audit.attribute($result.event, $parsed.command));

if (not $logCfg.quiet) {
    io.printf("%s\n", $result.message);
}

if (not $result.ok) {
    exit 1;
}
