#!/usr/bin/env -S jennifer serve
# SPDX-License-Identifier: LGPL-3.0-only
# SPDX-FileCopyrightText: Copyright (C) 2026 mplx <jennifer@mplx.dev>
# pragma-jennifer-version: >=0.25.0
#
# serve: the deck registry's HTTP API and website. A thin `webapi` app; each
# handler reads the store and delegates status and body to the view modules
# (`apiview`, `webview`, `publishview`, ...), which hold the logic and its tests.
# The store path defaults to data/decks.json (REGISTRY_DB) and the listen address
# to :8080 (REGISTRY_ADDR). Run from the repo root:
#
#     jennifer serve bin/serve
#
# then e.g. `curl 'http://localhost:8080/resolve?name=@acme/tool&constraint=^1.2.0'`.

use os;
use io;
use kv;
use time;
use json;
use fs;
use convert;
use strings;
use httpd;
use path;
use task;
import "flatdb.j" as flatdb;
import "web.j" as web;
import "webapi.j" as webapi;
import "../src/store.j" as store;
import "../src/apiview.j" as view;
import "../src/webview.j" as webview;
import "../src/search.j" as search;
import "../src/authview.j" as authview;
import "../src/identity.j" as identity;
import "../src/identity/github.j" as githubIdentity;
import "../src/identity/gitlab.j" as gitlabIdentity;
import "../src/identity/gitea.j" as giteaIdentity;
import "../src/identity/oidc.j" as oidcIdentity;
import "../src/token.j" as token;
import "../src/audit.j" as audit;
import "../src/forge.j" as forge;
import "../src/forge/github.j" as githubForge;
import "../src/forge/gitlab.j" as gitlabForge;
import "../src/forge/gitea.j" as giteaForge;
import "../src/publishview.j" as publishview;
import "../src/trustpub.j" as trustpub;
