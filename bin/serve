# Configuration: defaults, then config.toml, then the environment, which wins.
# `config` merges as a pure function (tested); this only reads.
def configPath as string init config.DEFAULT_PATH;
if (not (os.getEnv(config.PATH_ENV) == "")) {
    $configPath = os.getEnv(config.PATH_ENV);
}

def configText as string init "";
if (fs.exists($configPath)) {
    $configText = fs.readString($configPath);
}

# Only the variables named here are read, so an unrecognised REGISTRY_* setting
# is a visible no-op. The list is also the set of overridable settings.
def envNames as list of string init [
    "REGISTRY_URL",
    "REGISTRY_CLIENT_IP_HEADER",
    "REGISTRY_POLICY",
    "REGISTRY_ADDR",
    "REGISTRY_DB",
    "REGISTRY_LOG",
    "REGISTRY_LOG_LEVEL",
    "REGISTRY_LOG_FORMAT",
    "REGISTRY_LOG_REQUESTS",
    "REGISTRY_IDENTITY",
    "REGISTRY_IDENTITY_BASEURL",
    "REGISTRY_IDENTITY_CLIENTID",
    "REGISTRY_IDENTITY_SECRET",
    "REGISTRY_IDENTITY_SCOPES",
    "REGISTRY_ORG_MAX_AGE",
    "REGISTRY_AUTH_RATE_LIMIT",
    "REGISTRY_WRITE_RATE_LIMIT",
    "REGISTRY_READ_RATE_LIMIT",
    "REGISTRY_TOKEN_KEY",
    "REGISTRY_FORGE",
    "REGISTRY_FORGE_BASEURL",
    "REGISTRY_FORGE_TOKEN",
    "REGISTRY_FORGE_HOST",
    "REGISTRY_SOURCE_AUTHORITY",
    "REGISTRY_MAX_IN_FLIGHT",
    "REGISTRY_RESPOND_TIMEOUT",
    "REGISTRY_TRUSTPUB_AUDIENCE",
    "REGISTRY_TRUSTPUB_PROVIDER",
    "REGISTRY_TRUSTPUB_ISSUER",
    "REGISTRY_TLS",
    "REGISTRY_TLS_ADDR",
    "REGISTRY_TLS_DOMAINS",
    "REGISTRY_TLS_EMAIL",
    "REGISTRY_TLS_CERTDIR",
    "REGISTRY_TLS_RENEW_BEFORE_DAYS",
    "REGISTRY_ACME_DIRECTORY",
    "REGISTRY_ACME_CHALLENGEDIR",
    "REGISTRY_ACME_AGREE_TOS"
];
def read as config.EnvRead init config.readEnv($envNames);
for (def old in $read.deprecated) {
    io.eprintf("warning: %s is deprecated and will stop being read\n", $old);
}
def env as map of string to string init $read.values;

def cfg as config.Config;
try {
    $cfg = config.applyEnv(config.applyToml(config.defaults(), $configText), $env);
} catch (err) {
    io.eprintf("cannot read %s: %s\n", $configPath, $err.message);
    exit 1;
}

# A configuration that cannot be served is refused at boot, naming the problem.
def complaint as string init config.problem($cfg);
if (not ($complaint == "")) {
    io.eprintf("configuration: %s\n", $complaint);
    exit 1;
}

def dbPath as string init $cfg.dbPath;
def addr as string init $cfg.addr;

# The operational log. The console sink is always on for the server; the file
# is shared with `deckadmin`, so one file records both programs' events.
#
# All top-level state is read-only from here on: handlers run concurrently and
# must never write it.
def logSink as audit.Sink init audit.open($cfg.logLevel, $cfg.logFormat, $cfg.logFile, true);
if (not ($logSink.fileError == "")) {
    io.eprintf("warning: not logging to %s (%s)\n", $cfg.logFile, $logSink.fileError);
}

# Check once at boot that the data directory is writable. The usual cause of a
# failure is a volume behind /app/data owned by a uid other than the image's.
# It only warns: an unwritable registry can still serve every deck it has.
def dataDir as string init path.dir($cfg.dbPath);
if ($dataDir == "") {
    $dataDir = ".";
}
def probe as string init $dataDir + "/.write-probe";
try {
    fs.writeString($probe, "");
    fs.remove($probe);
} catch (err) {
    io.eprintf("warning: %s is not writable (%s)\n", $dataDir, $err.message);
    io.eprintf("  the registry will serve what it has and refuse every write.\n");
    io.eprintf("  this container runs as a fixed uid; the volume behind %s must\n", $dataDir);
    io.eprintf("  belong to it. `docker run --rm --entrypoint /bin/sh <image> -c id`\n");
    io.eprintf("  prints the uid to chown to, or build with UID / GID to match.\n");
}

# Whether to log every request at `info`. A separate switch from the level,
# because one line per request (health probes included) is too noisy by default.
def logRequests as bool init $cfg.logRequests;

# The static site. `web.serveDir` joins the whole request path onto its root, so
# /reference/api.html resolves to public/reference/api.html, where grimoire
# builds it. Three books: the manual, the reference and the specifications.
def const PUBLIC_ROOT as string init "public";
def const REFERENCE_ROOT as string init "public/reference";
def const MANUAL_ROOT as string init "public/manual";
def const MANUAL_CONFIG as string init "grimoire-manual.toml";
def const SPECS_ROOT as string init "public/specs";
def const SPECS_CONFIG as string init "grimoire-specs.toml";

# The token-exchange paths, advertised absolutely in the discovery document and
# mounted under the versioned API. A client uses the advertised strings verbatim.
def const AUTH_DEVICE_PATH as string init "/v1/auth/device";
def const AUTH_TOKEN_PATH as string init "/v1/auth/token";
def const AUTH_REFRESH_PATH as string init "/v1/auth/refresh";
def const PUBLISH_PATH as string init "/v1/publish";

# The API majors this registry serves, for the 4.5 refusal. A new mount adds its
# major here and to the route table.
def const SERVED_APIS as list of int init [1];

# Credential lifetimes in seconds. The bearer token is short-lived so it is not a
# long-lived secret in a dotfile; the refresh token rotates on use.
def const TOKEN_TTL as int init 3600;
def const REFRESH_TTL as int init 1209600;

# The auth surface needs an OAuth client id and a signing key. Without either,
# the auth routes are not served and no `auth` object is advertised.
#
# selectProvider maps the configured provider name onto its vtable. This is the
# only place a provider is named; adding one is a module under src/identity/
# and one arm here.
func selectProvider(name as string) {
    match ($name) {
        when "gitlab" { return gitlabIdentity.provider(); }
        when "gitea", "forgejo" { return giteaIdentity.provider(); }
        when "oidc" { return oidcIdentity.provider(); }
    }
    return githubIdentity.provider();
}

def providerName as string init $cfg.identity;

def auth as authview.Config init authview.Config{
    provider: selectProvider($providerName),
    providerConfig: identity.Config{
        name: $providerName,
        baseUrl: $cfg.identityBaseUrl,
        clientId: $cfg.identityClientId,
        clientSecret: $cfg.identitySecret,
        scopes: $cfg.identityScopes,
        metadata: ""
    },
    signingKey: convert.bytesFromString($cfg.tokenKey, "utf-8"),
    tokenTtl: TOKEN_TTL,
    refreshTtl: REFRESH_TTL,
    orgMaxAge: $cfg.orgMaxAgeHours * 3600
};
def authOn as bool init authview.enabled($auth);

# Section 11: the `/auth` routes call the provider for anybody, so they share a
# per-address budget (`throttle`). With the setting at 0, `authThrottled` never
# consults it.
def authLimiter as ratelimit.Limiter init throttle.limiter($cfg.authRateLimit);

# Section 11, the other two budgets: writes per authenticated subject (per
# address until a credential is known), and the two reads that cost real CPU,
# `/resolve-graph` and a full `/search` listing, per address. 0 turns one off.
def writeRateLimit as int init $cfg.writeRateLimit;
def readRateLimit as int init $cfg.readRateLimit;
def writeLimiter as ratelimit.Limiter init throttle.limiter($writeRateLimit);
def readLimiter as ratelimit.Limiter init throttle.limiter($readRateLimit);

# The provider's discovery document, fetched once at boot (12.2) and carried in
# the configuration, so a login makes no extra round trip. A provider that cannot
# be asked gets no `auth` advertised: every login would fail, and the reason
# belongs in the boot log, not in a poll's 502.
if ($authOn) {
    try {
        $auth.providerConfig.metadata = $auth.provider.discover($auth.providerConfig);
    } catch (err) {
        io.printf(
            "warning: could not read the discovery document of %s (%s); logins are off\n",
            $providerName,
            $err.message);
        $authOn = false;
    }
}

# selectForge maps the configured forge name onto its vtable. Identity and forge
# are configured separately (specification 12.1).
func selectForge(name as string) {
    match ($name) {
        when "gitlab" { return gitlabForge.forge(); }
        when "gitea", "forgejo" { return giteaForge.forge(); }
    }
    return githubForge.forge();
}

# selectPolicy maps the configured name onto the claim policy that decides who
# may claim a scope.
func selectPolicy(name as string) {
    match ($name) {
        when "operator" { return operatorPolicy.policy(); }
        when "firstcome" { return firstcomePolicy.policy(); }
    }
    return derivedPolicy.policy();
}

def claimPolicy as policy.Policy init selectPolicy($cfg.policy);

def forgeName as string init $cfg.forge;

def theForge as forge.Forge init selectForge($forgeName);
def forgeConfig as forge.Config init forge.Config{
    name: $forgeName,
    baseUrl: $cfg.forgeBaseUrl,
    apiToken: $cfg.forgeToken,
    host: $cfg.forgeHost
};

# How a publish proves push access to its repository (7.1 route A): `login` asks
# with the caller's own sealed provider token, `service` with the registry's
# forge token. `config.problem` has already refused a setting that cannot work.
def sourceAuthority as string init config.sourceAuthorityOf($cfg);

# Trusted publishing (8.9), on only when an audience and issuer are configured.
# The audience is public (advertised in discovery); checking it stops a token
# minted for another service being replayed here.
def tpAudience as string init $cfg.trustpubAudience;
def tpProvider as string init $cfg.trustpubProvider;
def tpIssuer as string init trustpub.expectedIssuer($tpProvider, $cfg.trustpubIssuer);
def tpOn as bool init not (strings.trim($tpAudience) == "") and not ($tpIssuer == "");

# The issuer's key set, fetched once at boot so a publish does not depend on the
# issuer being reachable. A key rotation needs a restart.
def tpKeys as string init "";
if ($tpOn) {
    try {
        $tpKeys = trustpub.fetchJwks($tpIssuer);
    } catch (err) {
        io.printf(
            "warning: could not fetch the key set for %s (%s); " +
                "trusted publishing is off\n",
            $tpIssuer,
            $err.message);
        $tpOn = false;
    }
}

# The login flow to advertise, asked of the provider once at boot (OIDC answers
# with a network fetch). An unreachable provider falls back to "device".
def authFlow as string init "device";
if ($authOn) {
    try {
        $authFlow = $auth.provider.flow($auth.providerConfig);
    } catch (err) {
        io.printf(
            "warning: could not ask %s which flow it offers (%s); advertising device\n",
            $providerName,
            $err.message);
    }
}

# Under `authcode` the client runs the flow against the provider itself, so the
# discovery document carries the provider's authorization endpoint, the client
# id and the scopes (12.2). Asked once, like the flow.
def authAuthorize as string init "";
def authScopes as string init "";
if ($authOn and $authFlow == "authcode") {
    try {
        $authAuthorize = $auth.provider.authorizeUrl($auth.providerConfig);
    } catch (err) {
        $authAuthorize = "";
    }
    $authScopes = $auth.provider.scopes($auth.providerConfig);
    if ($authAuthorize == "") {
        io.printf("warning: %s offers authcode but no authorization endpoint\n", $providerName);
    }
}

# --- resolution counting -----------------------------------------------------
#
# Successful metadata lookups are counted per deck. These are lookups, not
# installs: clients fetch code from the deck's repository.
#
# The counter is a `kv.Store` (mutex, atomic `incr`, shared across tasks)
# because handlers must never write top-level program state.
#
# Counts are kept in memory and flushed periodically, so reads never take the
# write lock.
def hits as kv.Store init kv.open();

# How often the accumulated counts are folded into the store.
def const FLUSH_SECONDS as int init 60;

# How long a counter lives after it was created. A deck-hour counter is only
# incremented during its hour and the flush reads it within a minute, so three
# hours is slack; the TTL exists so a counter the sweep no longer visits (a
# removed deck, a flush that kept failing) does not stay in memory forever.
def const COUNTER_TTL_SECONDS as int init 10800;

# countLookup records one metadata lookup against a deck.
#
# Keyed by deck and hour, so a flush attributes a lookup to the hour it happened.
# `kv.incr` does not create a missing key, hence add-then-retry: `add` fails if
# another worker created the key first, and the retry increments it.
func countLookup(name as string) {
    if (strings.trim($name) == "") {
        return null;
    }
    def key as string init hitKey(deckname.fold($name), stats.hourKey(nowSeconds()));
    if (kv.incr($hits, $key, 1) == -1) {
        if (not kv.add($hits, $key, "1", COUNTER_TTL_SECONDS)) {
            kv.incr($hits, $key, 1);
        }
    }
    return null;
}

# hitKey names the counter for one deck in one hour.
func hitKey(folded as string, hour as string) {
    return $folded + " " + $hour;
}

# nowSeconds is the clock; views are handed a timestamp and never read one.
func nowSeconds() {
    return time.unix(time.utc());
}

# flushCounts folds what has accumulated into the registry document.
#
# `kv` cannot enumerate keys, so the deck list drives the sweep: the current and
# previous hour's counters of each deck. Two suffice because the flush interval
# is far shorter than an hour.
#
# Each counter is decremented by exactly what was read, never deleted, so a
# lookup landing mid-flush is carried to the next flush.
func flushCounts() {
    def now as int init nowSeconds();
    def hours as list of string init [stats.hourKey($now), stats.hourKey($now - 3600)];
    def pending as map of string to int init {};
    def db as flatdb.DB init sharedStore();
    for (def name in store.listDecks($db)) {
        for (def hour in $hours) {
            def key as string init hitKey($name, $hour);
            def n as int init counterValue($key);
            if ($n > 0) {
                $pending[$key] = $n;
            }
        }
    }
    if (len($pending) == 0) {
        return null;
    }
    # Locked only when something is pending; re-read inside the lock, since a
    # copy opened before it may be behind.
    def held as store.Lock init store.lock($dbPath);
    defer store.unlock($held);
    def out as flatdb.DB init store.open($dbPath);
    for (def key in $pending) {
        def name as string init strings.substring(
            $key,
            0,
            len($key) - len(stats.hourKey($now)) - 1);
        def hour as string init strings.substring(
            $key,
            len($key) - len(stats.hourKey($now)),
            len($key));
        $out = store.putStats(
            $out,
            $name,
            stats.record(store.getStats($out, $name), $hour, $pending[$key], $now));
        kv.incr($hits, $key, 0 - $pending[$key]);
    }
    store.save($out);
    return null;
}

# counterValue reads a counter, treating an absent key as zero.
func counterValue(key as string) {
    if (not kv.has($hits, $key)) {
        return 0;
    }
    return convert.toInt(kv.get($hits, $key));
}

/**
 * GET /: the landing page for a browser, the service index for an API client,
 * chosen by `Accept`.
 * @param ctx {web.Context} the request context
 */
func apiIndex(ctx as web.Context) {
    if (webapi.wants($ctx) == "html") {
        def db as flatdb.DB init sharedStore();
        def page as webview.Page init webview.home($db);
        web.html($ctx, $page.status, $page.body);
        return;
    }
    def reply as view.Reply init view.index($authOn);
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /search?q=: deck search, as a paged HTML page or as JSON. Both read the
 * same shared index.
 * @param ctx {web.Context} the request context
 */
func apiSearch(ctx as web.Context) {
    def query as string init web.query($ctx, "q");
    if (webapi.wants($ctx) == "html") {
        def page as webview.Page init webview.resultsIn(
            sharedIndex(),
            sharedLowered(),
            $query,
            pageOf($ctx));
        web.html($ctx, $page.status, $page.body);
        return;
    }
    # An empty query serialises the whole index (about 1 MB at 5,000 decks).
    if (strings.trim($query) == "" and readThrottled($ctx)) {
        return;
    }
    def reply as view.Reply init view.searchIn(sharedIndex(), sharedLowered(), $query);
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /deck/:scope/:deck: a deck's page. The scoped name is rebuilt from the two
 * captures, so its `/` never passes through routing. Kept apart from the JSON
 * `/decks/:name/:version`, which would read a scoped name as name plus version.
 * @param ctx {web.Context} the request context
 */
func siteDeck(ctx as web.Context) {
    def name as string init "@" + web.param($ctx, "scope") + "/" + web.param($ctx, "deck");
    # One URL per deck: a differently cased spelling is redirected to the folded
    # one rather than rendered as a second page.
    def folded as string init deckname.fold($name);
    def canonical as string init "/deck/" + strings.substring($folded, 1, len($folded));
    if (not (web.path($ctx) == $canonical)) {
        web.redirect($ctx, 301, $canonical);
        return;
    }
    def page as webview.Page init webview.deck(sharedStore(), $folded, nowSeconds());
    web.html($ctx, $page.status, $page.body);
}

# pageOf reads a listing's `?page=` parameter.
func pageOf(ctx as web.Context) {
    return webview.pageNumber(web.query($ctx, "page"));
}

/**
 * GET /browse?page=: every deck, a page at a time.
 * @param ctx {web.Context} the request context
 */
func siteBrowse(ctx as web.Context) {
    def page as webview.Page init webview.browse(sharedIndex(), pageOf($ctx));
    web.html($ctx, $page.status, $page.body);
}

/**
 * GET /tags: the tag index.
 * @param ctx {web.Context} the request context
 */
func siteTags(ctx as web.Context) {
    def page as webview.Page init webview.tagsFrom(sharedTagMap());
    web.html($ctx, $page.status, $page.body);
}

/**
 * GET /tag/:name?page=: the decks carrying one tag.
 * @param ctx {web.Context} the request context
 */
func siteTag(ctx as web.Context) {
    def name as string init web.param($ctx, "name");
    def page as webview.Page init webview.tagIn(sharedIndex(), sharedTagMap(), $name, pageOf($ctx));
    web.html($ctx, $page.status, $page.body);
}

/**
 * GET /scope/:name?page=: who holds a scope, and what is published under it.
 * @param ctx {web.Context} the request context
 */
func siteScope(ctx as web.Context) {
    def name as string init web.param($ctx, "name");
    def page as webview.Page init webview.scopeIn(
        sharedStore(),
        sharedIndex(),
        sharedScopeMap(),
        $name,
        pageOf($ctx));
    web.html($ctx, $page.status, $page.body);
}

/**
 * GET /reference/...: the admin manual (API and CLI) built into
 * public/reference. When it is not built, the page explains instead of a 404.
 * @param ctx {web.Context} the request context
 */
func siteReference(ctx as web.Context) {
    if (not fs.isDir(REFERENCE_ROOT)) {
        def page as webview.Page init webview.sectionMissing("Admin manual", REFERENCE_ROOT, "");
        web.html($ctx, $page.status, $page.body);
        return;
    }
    web.serveDir($ctx, PUBLIC_ROOT);
}

/**
 * GET /manual/...: the user manual built into public/manual. When it is not
 * built, the page explains instead of a 404.
 * @param ctx {web.Context} the request context
 */
func siteManual(ctx as web.Context) {
    if (not fs.isDir(MANUAL_ROOT)) {
        def page as webview.Page init webview.sectionMissing(
            "User manual",
            MANUAL_ROOT,
            MANUAL_CONFIG);
        web.html($ctx, $page.status, $page.body);
        return;
    }
    web.serveDir($ctx, PUBLIC_ROOT);
}

/**
 * GET /specs/...: the server and client specifications built into public/specs.
 * @param ctx {web.Context} the request context
 */
func siteSpecs(ctx as web.Context) {
    if (not fs.isDir(SPECS_ROOT)) {
        def page as webview.Page init webview.sectionMissing(
            "Specifications",
            SPECS_ROOT,
            SPECS_CONFIG);
        web.html($ctx, $page.status, $page.body);
        return;
    }
    web.serveDir($ctx, PUBLIC_ROOT);
}

/**
 * GET /.well-known/jennifer-registry: the discovery document a client reads to
 * negotiate the API version before any other call.
 * @param ctx {web.Context} the request context
 */
func apiDiscovery(ctx as web.Context) {
    def base as json.Value init webapi.discovery($api, view.SERVICE_NAME, view.SPEC_VERSION);
    def urls as map of string to string init {};
    def trusted as view.TrustedPublishing init view.TrustedPublishing{
        audience: "",
        providers: [],
        url: ""
    };
    if ($tpOn) {
        # A CI job must name this audience when minting its token.
        $trusted.audience = $tpAudience;
        $trusted.providers = [$tpProvider];
        $trusted.url = PUBLISH_PATH;
    }
    if ($authOn) {
        $urls["provider"] = $providerName;
        $urls["flow"] = $authFlow;
        if ($authFlow == "authcode") {
            $urls["authorizeUrl"] = $authAuthorize;
            $urls["clientId"] = $cfg.identityClientId;
            $urls["scopes"] = $authScopes;
        } else {
            $urls["deviceUrl"] = AUTH_DEVICE_PATH;
        }
        $urls["tokenUrl"] = AUTH_TOKEN_PATH;
        $urls["refreshUrl"] = AUTH_REFRESH_PATH;
    }
    def reply as view.Reply init view.discovery($base, $cfg.canonicalUrl, $urls, $trusted);
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

# The parsed registry every read shares. A `json.Value` is immutable and
# `kv.setValue` stores it without copying, so one parse serves every concurrent
# reader.
def shared as kv.Store init kv.open();

# How long a parsed copy is served before it is parsed again, even if the file
# looks unchanged. The key is mtime and size, which a write within one mtime
# tick at the same size leaves unchanged; this bounds how long it goes unseen.
def const SHARED_TTL_SECONDS as int init 30;

# sharedStore is the registry as of now, parsed once per change of the file and
# shared by every reader. For reads only: a write re-opens the file under the
# lock (`store.open`). The copy carries an empty version, so `flatdb.save`
# refuses it if it reaches a write.
#
# The file is stat'ed before it is read, so a copy is never older than its key.
# A missing file is the empty registry and is not cached.
func sharedStore() {
    if (not fs.exists($dbPath)) {
        return store.open($dbPath);
    }
    def key as string init "db " + fileVersion();
    if (kv.has($shared, $key) or awaitBuild($key, $key)) {
        try {
            return flatdb.DB{path: $dbPath, data: kv.getValue($shared, $key), version: ""};
        } catch (err) { # lint-disable: L103
            # expired between the two calls; parse it again below
        }
    }
    def db as flatdb.DB init store.open($dbPath);
    keepShared("current db", $key, $db.data);
    return flatdb.DB{path: $dbPath, data: $db.data, version: ""};
}

# The four shared read values: the deck index (`search.index`) and the three
# lookups derived from it (`search.lowered`, `tagMap`, `scopeMap`), built once
# per change of the file and shared like the store. Every listing and search
# reads them; building the index sorts every deck's versions (about 0.7 s at
# 5,000 decks), the three lookups add about 0.1 s and turn the per-request scans
# of the index (13 to 44 ms each at that size) into lookups.
#
# All four are built from one index and filed under one file version, so the
# positions a lookup holds refer to the index served with it. `sharedStore` may
# return a newer copy, which only makes the index newer than its key.
func sharedIndex() {
    return sharedPart("index");
}

func sharedLowered() {
    return sharedPart("lowered");
}

func sharedTagMap() {
    return sharedPart("tags");
}

func sharedScopeMap() {
    return sharedPart("scopes");
}

# sharedPart is one of the four by name. One reader builds all four while the
# rest wait on the index's marker; a part missing after the build (expired
# between two calls) is rebuilt from the index that was just filed.
func sharedPart(name as string) {
    if (not fs.exists($dbPath)) {
        return partOf($name, search.index(store.open($dbPath)));
    }
    def version as string init fileVersion();
    def key as string init $name + " " + $version;
    if (kv.has($shared, $key) or awaitBuild("index " + $version, $key)) {
        try {
            return kv.getValue($shared, $key);
        } catch (err) { # lint-disable: L103
            # expired between the two calls; build it again below
        }
    }
    def index as json.Value init search.index(sharedStore());
    keepShared("current index", "index " + $version, $index);
    for (def part in ["lowered", "tags", "scopes"]) {
        keepShared("current " + $part, $part + " " + $version, partOf($part, $index));
    }
    return partOf($name, $index);
}

# partOf builds one shared part from an index; "index" is the index itself.
func partOf(name as string, index as json.Value) {
    match ($name) {
        when "lowered" { return search.lowered($index); }
        when "tags" { return search.tagMap($index); }
        when "scopes" { return search.scopeMap($index); }
    }
    return $index;
}

# fileVersion names the registry file's current version by its mtime and size.
func fileVersion() {
    def st as fs.Stat init fs.stat($dbPath);
    return convert.toString($st.mtimeNanos) + ":" + convert.toString($st.size);
}

# keepShared files a freshly built value for every reader, releases readers
# waiting in `awaitParse`, and drops the value it replaces in the same `slot`
# rather than leaving it in memory until its TTL.
func keepShared(slot as string, key as string, value as json.Value) {
    kv.setValue($shared, $key, $value, SHARED_TTL_SECONDS);
    kv.delete($shared, "parsing " + $key);
    def previous as string init kv.get($shared, $slot);
    if (not ($previous == "" or $previous == $key)) {
        kv.delete($shared, $previous);
    }
    kv.set($shared, $slot, $key, 0);
}

# How long a reader waits for another reader's parse (or index build) before
# doing it itself.
def const PARSE_WAIT_MS as int init 5000;
def const PARSE_POLL_MS as int init 20;

# awaitBuild makes one reader the parser of a new file version (or builder of
# its index and lookups) while the rest wait for its copy, so a burst of readers
# after a write does not parse a copy each (measured: most of the peak memory
# under load). `marker` names the build, `key` the value waited for; the index
# and its lookups share one marker. Returns true when the copy is ready to
# share, false when this reader must build it: it won the marker, or the builder
# took too long. A builder that throws leaves its marker to expire.
func awaitBuild(marker as string, key as string) {
    if (kv.add($shared, "parsing " + $marker, "1", 10)) {
        return false;
    }
    def waited as int init 0;
    while ($waited < PARSE_WAIT_MS) {
        time.sleep(time.fromMilliseconds(PARSE_POLL_MS));
        $waited = $waited + PARSE_POLL_MS;
        if (kv.has($shared, $key)) {
            return true;
        }
    }
    return false;
}

# lockedStore takes the registry's write lock. Every writing handler goes
# through it and must `defer store.unlock` on the result.
#
# Read inside the lock as well as write (`store.open`, never `sharedStore`):
# `flatdb.save` does not lock, so concurrent open-edit-save cycles lose edits.
func lockedStore() {
    return store.lock($dbPath);
}

# answerAuth sends an AuthReply, persists the store when it was edited, and
# records what happened. Shared by the three auth handlers.
#
# The log record reads only the account, login and orgs from the reply, never
# its tokens, so no credential reaches the log.
func answerAuth(ctx as web.Context, stage as string, out as authview.AuthReply) {
    if ($out.changed) {
        store.save($out.db);
    }
    if ($out.status == 200 and json.has($out.body, "/subject")) {
        def who as string init json.asString($out.body, "/subject");
        def names as list of string init [];
        for (def i in 0..json.length($out.body, "/orgs")) {
            $names[] = json.asString($out.body, "/orgs/" + convert.toString($i));
        }
        def orgs as string init strings.join($names, ",");
        audit.write(
            $logSink,
            audit.tokenIssued($stage, $who, json.asString($out.body, "/login"), $orgs));
    } elseif ($out.status == 200) {
        audit.write($logSink, audit.loginStarted($providerName));
    } else {
        def why as string init "";
        if (json.has($out.body, "/error")) {
            $why = json.asString($out.body, "/error");
        }
        audit.write($logSink, audit.loginRefused($stage, $out.status, $why));
    }
    webapi.sendJson($ctx, $out.status, $out.body);
}

# requestText is the request body decoded as UTF-8 (`web.body` returns bytes).
func requestText(ctx as web.Context) {
    return convert.stringFromBytes(web.body($ctx), "utf-8");
}

# throttled answers `429` with `Retry-After` and returns true when `key` has
# used its budget in `limiter` for the window; a limit of 0 is no budget. `what`
# names the budget in the reply and the log.
func throttled(
    ctx as web.Context,
    limiter as ratelimit.Limiter,
    limit as int,
    key as string,
    what as string) {
    if ($limit == 0) {
        return false;
    }
    def got as ratelimit.Result init ratelimit.check($limiter, $key);
    if ($got.allowed) {
        return false;
    }
    def fields as map of string to string init {
        "budget": $what,
        "path": web.path($ctx),
        "key": $key
    };
    # Debug: under a flood this is one line per refused request.
    audit.write($logSink, audit.event("debug", "rate limited", $fields));
    web.setHeader($ctx, "Retry-After", convert.toString($got.retryAfter));
    webapi.fail(
        $ctx,
        429,
        "too many " + $what + " requests; retry in " +
            convert.toString($got.retryAfter) + " s");
    return true;
}

# clientKey is the budget a connection's client counts against (`throttle.keyOf`
# over the address, with the trusted header honoured).
func clientKey(ctx as web.Context) {
    return throttle.keyOf(audit.clientOf(forwardedFor($ctx), web.remoteAddr($ctx)));
}

# authThrottled is the `/auth` budget per client address.
func authThrottled(ctx as web.Context) {
    return throttled($ctx, $authLimiter, $cfg.authRateLimit, clientKey($ctx), "login");
}

# writeThrottled is the write budget, per authenticated subject where one is
# known (the caller passes the key), else per client address.
func writeThrottled(ctx as web.Context, key as string) {
    return throttled($ctx, $writeLimiter, $writeRateLimit, $key, "write");
}

# readThrottled is the budget for the two reads that cost real CPU, per address.
func readThrottled(ctx as web.Context) {
    return throttled($ctx, $readLimiter, $readRateLimit, clientKey($ctx), "read");
}

/**
 * POST /auth/device: begin a device authorization with the identity provider and
 * return the code the user types.
 * @param ctx {web.Context} the request context
 */
func apiAuthDevice(ctx as web.Context) {
    if (authThrottled($ctx)) {
        return;
    }
    # Writes nothing, so no lock is held across the provider call.
    def db as flatdb.DB init sharedStore();
    answerAuth($ctx, "device", authview.device($auth, $db));
}

/**
 * POST /auth/token: exchange an approved device code for a registry token.
 * @param ctx {web.Context} the request context
 */
func apiAuthToken(ctx as web.Context) {
    if (authThrottled($ctx)) {
        return;
    }
    # Provider calls run unlocked; the lock covers only recording the refresh token.
    def got as authview.Login init authview.login($auth, requestText($ctx));
    if (not $got.ok) {
        answerAuth($ctx, "issued", $got.reply);
        return;
    }
    # 12.5, `service` source authority: map the login onto a forge account by
    # the username both services agree on, and record it by the forge's
    # immutable id. Asked unlocked, like the provider.
    def mapped as string init "unasked";
    def linked as forge.Account init forge.noAccount();
    if ($sourceAuthority == "service") {
        try {
            $linked = forge.agreedAccount($got.login, $theForge.account($forgeConfig, $got.login));
            $mapped = "answered";
        } catch (err) {
            $mapped = "unknown";
        }
    }
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    def db as flatdb.DB init store.open($dbPath);
    def now as int init token.now();
    def out as authview.AuthReply init authview.issueLogin($auth, $db, $got, $now);
    if ($out.status == 200 and $mapped == "answered") {
        # A login whose mapping failed must not keep an older link. A forge that
        # could not be asked says nothing either way, so that keeps it.
        if ($linked.id == "") {
            $out.db = store.deleteForgeLink($out.db, $got.subject);
        } else {
            def link as store.ForgeLink init store.ForgeLink{
                forgeId: $linked.id,
                forgeLogin: $linked.login,
                linkedAt: $now
            };
            $out.db = store.putForgeLink($out.db, $got.subject, $link);
        }
    }
    answerAuth($ctx, "issued", $out);
}

/**
 * POST /auth/refresh: exchange a refresh token for a new token pair.
 * @param ctx {web.Context} the request context
 */
func apiAuthRefresh(ctx as web.Context) {
    if (authThrottled($ctx)) {
        return;
    }
    def body as string init requestText($ctx);
    # 8.5: the provider is asked before the lock, as in `apiAuthToken`.
    def grant as string init authview.checkGrant($auth, sharedStore(), $body);
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    def db as flatdb.DB init store.open($dbPath);
    answerAuth($ctx, "refreshed", authview.refresh($auth, $db, $body, token.now(), $grant));
}

# publishRequestProblem is why a publish request cannot be sent to the forge,
# or "". Adapters read through their own base URL plus the URL's path, while
# clients install from the URL itself, so a host the forge does not claim would
# be read from one place and installed from another. The tag goes into those API
# paths too, so it must not be able to redirect them.
func publishRequestProblem(repository as string, tag as string) {
    def urlProblem as string init forge.repositoryProblem($repository);
    if (not ($urlProblem == "")) {
        return $urlProblem;
    }
    if (not $theForge.handles($forgeConfig, $repository)) {
        return "this registry does not publish from " + forge.hostOf($repository);
    }
    def originComplaint as string init forge.originProblem($repository, $forgeConfig.baseUrl);
    if (not ($originComplaint == "")) {
        return $originComplaint;
    }
    # 3.1, before any forge call: `checkSource` refuses this too, but only after
    # the round trips.
    if (store.isObjectIdLike($tag)) {
        return "the tag " + $tag + " is shaped like a git object id, which cannot be a pin";
    }
    return forge.tagProblem($tag);
}

# sourceFrom makes every forge call of a publish and assembles the result for
# publishview: resolve the tag to a commit, read `deck.toml` at that commit, and
# look up the repository. The manifest never comes from the request body
# (specification 7), so the scope check is made against the repository content.
func sourceFrom(repository as string, tag as string) {
    def commit as string init $theForge.resolveTag($forgeConfig, $repository, $tag);
    # The commit goes into every read URL below, so anything but a full SHA stops
    # here, for `checkSource` to refuse as a 400.
    if (not store.isCommit($commit)) {
        return publishview.Source{
            repository: $repository,
            tag: $tag,
            commit: $commit,
            repoId: "",
            repoOwnerId: "",
            repoOwner: "",
            manifestText: "",
            readmeText: "",
            commitShadowed: false,
            entryPresent: false,
            authority: forge.unknown("not asked: the tag did not resolve to a commit")
        };
    }
    # Commit shadowing, for `checkSource` to judge: forges resolve `?ref=` as a
    # name before an object, so a ref named `<commit>` would answer the reads
    # below. `refExists` throws when the forge will not say, which becomes a 502.
    def shadowed as bool init $theForge.refExists($forgeConfig, $repository, $commit);
    def text as string init $theForge.readFile($forgeConfig, $repository, $commit, "deck.toml");
    def r as forge.Repo init $theForge.repo($forgeConfig, $repository);
    # The README is optional and read at the same commit as the manifest.
    def readme as string init "";
    try {
        $readme = $theForge.readFile($forgeConfig, $repository, $commit, "README.md");
    } catch (err) {
        $readme = "";
    }
    # Whether the entry module the manifest's name implies (6.1) exists. An
    # unparsable manifest names none; the publish reports its parse error.
    def entry as string init publishview.entryPathFor($text);
    def entryPresent as bool init false;
    if (not ($entry == "")) {
        $entryPresent = $theForge.fileExists($forgeConfig, $repository, $commit, $entry);
    }
    # Asked again after the reads, to catch a shadowing ref created meanwhile.
    # A shadow at either end refuses.
    if (not $shadowed) {
        $shadowed = $theForge.refExists($forgeConfig, $repository, $commit);
    }
    return publishview.Source{
        repository: $repository,
        tag: $tag,
        commit: $commit,
        repoId: $r.id,
        repoOwnerId: $r.ownerId,
        repoOwner: $r.owner,
        manifestText: $text,
        readmeText: $readme,
        commitShadowed: $shadowed,
        entryPresent: $entryPresent,
        authority: forge.unknown("not asked yet")
    };
}

# authorityFor asks the forge whether the account behind a publish may push to
# its repository (7.1 route A): the caller for a bearer token, `ciPrincipal` for
# a CI token. Not asked for trusted publishing, whose token proves the
# repository. Never throws: a check that cannot be made is `unknown`, which
# publishview refuses.
func authorityFor(
    mode as string,
    db as flatdb.DB,
    who as identity.Subject,
    ciRec as citoken.Token,
    src as publishview.Source) {
    if ($mode == "trusted") {
        return forge.unknown("not asked: trusted publishing proves the repository");
    }
    def principal as identity.Subject init $who;
    if ($mode == "ci") {
        $principal = publishview.ciPrincipal(
            $db,
            $ciRec,
            publishview.deckNameOf($src.manifestText));
    }
    try {
        return askForge($db, $principal, $src.repository);
    } catch (err) {
        return forge.unknown("the forge could not be asked: " + $err.message);
    }
}

# askForge asks with the configured credential: the account's own sealed
# provider token (`login`), or the registry's forge token about the forge
# account linked to the subject at login (`service`, 12.5).
func askForge(db as flatdb.DB, principal as identity.Subject, repository as string) {
    if ($principal.id == "") {
        return forge.unknown("there is no account behind this publish whose access " +
            "could be checked; a CI token for an organisation scope needs one");
    }
    if (not ($principal.provider == $providerName)) {
        return forge.unknown("the account behind this publish is on " +
            $principal.provider + ", not on this registry's identity provider");
    }
    if ($sourceAuthority == "service") {
        # 12.5: the forge account linked at login, by its immutable id, under the
        # username it has now. No link is unverifiable, never a guess.
        def link as store.ForgeLink init store.getForgeLink($db, $principal.id);
        if ($link.forgeId == "") {
            return forge.unknown("no forge account is linked to this account; log in " +
                "again so the registry can map it onto one");
        }
        def current as forge.Account init $theForge.accountById($forgeConfig, $link.forgeId);
        if ($current.id == "") {
            return forge.unknown("the forge account " + $link.forgeLogin +
                " linked to this account no longer exists");
        }
        return $theForge.permissionFor($forgeConfig, $repository, $current.login);
    }
    def sealed as string init store.getForgeToken($db, $principal.id);
    if ($sealed == "") {
        return forge.unknown("no forge credential is on record for this account; " +
            "log in again so the registry can ask the forge");
    }
    def credential as string init "";
    try {
        $credential = forgecred.unseal($auth.signingKey, $sealed);
    } catch (err) {
        return forge.unknown("the stored forge credential cannot be read; log in again");
    }
    return $theForge.permission($forgeConfig, $repository, $credential);
}

# callerOf turns an Authorization header into an identity, or an empty Subject
# when `authview.authenticate` throws (missing, malformed or expired token), so
# write paths answer 401 rather than 500.
func callerOf(ctx as web.Context) {
    def nobody as identity.Subject init identity.Subject{
        provider: "",
        id: "",
        login: "",
        orgs: {},
        orgsCheckedAt: ""
    };
    try {
        # Converts the token's `token.Identity` to an `identity.Subject`. The
        # token records no provider; a deployment has exactly one.
        def held as token.Identity init authview.authenticate(
            $auth,
            web.header($ctx, "Authorization"));
        return identity.Subject{
            provider: $providerName,
            id: $held.subject,
            login: $held.login,
            orgs: $held.orgs,
            orgsCheckedAt: convert.toString($held.orgsCheckedAt)
        };
    } catch (err) {
        return $nobody;
    }
}

# answerPublish sends a PublishReply, persists the store, and records the event.
func answerPublish(ctx as web.Context, out as publishview.PublishReply) {
    if ($out.changed) {
        store.save($out.db);
    }
    audit.write($logSink, $out.event);
    webapi.sendJson($ctx, $out.status, $out.body);
}

# fieldOf reads a string member of a request body, or "" when it is absent or
# not a string, so a malformed body gets the missing-field 400, not a 500.
func fieldOf(body as json.Value, pointer as string) {
    if (not json.has($body, $pointer) or not (json.typeOf($body, $pointer) == "string")) {
        return "";
    }
    return json.asString($body, $pointer);
}

# identityTokenOf is the CI identity token a publish presents (8.9), or "": sent
# in place of a bearer token and told apart by its issuer, or in the
# `identityToken` body field.
func identityTokenOf(body as json.Value, presented as string) {
    def inBody as string init fieldOf($body, "/identityToken");
    if (not ($inBody == "")) {
        return $inBody;
    }
    if ($tpOn and trustpub.isIdentityToken($presented, $tpIssuer)) {
        return $presented;
    }
    return "";
}

/**
 * POST /publish: publish a version from a repository and a tag.
 *
 * A body with `identityToken` is trusted publishing (8.9), authorised against a
 * binding; otherwise the `Authorization` header carries a CI token (8.10) or a
 * registry bearer token, authorised against the scope.
 * @param ctx {web.Context} the request context
 */
func apiPublish(ctx as web.Context) {
    def body as json.Value;
    try {
        $body = json.decode(requestText($ctx));
    } catch (err) {
        webapi.fail($ctx, 400, "the request body is not JSON");
        return;
    }
    def repository as string init fieldOf($body, "/repository");
    def tag as string init fieldOf($body, "/tag");
    def db as flatdb.DB init sharedStore();

    # The credential is checked from local state before any forge call, so an
    # unauthenticated caller cannot make the registry fetch a URL of its choosing.
    def mode as string init "token";
    def claims as trustpub.Claims;
    def ciRec as citoken.Token;
    def who as identity.Subject;

    def presented as string init web.bearerToken($ctx);
    def identityToken as string init identityTokenOf($body, $presented);
    if (not ($identityToken == "")) {
        $mode = "trusted";
        if (not $tpOn) {
            webapi.fail($ctx, 501, "this registry does not accept trusted publishing");
            return;
        }
        try {
            $claims = trustpub.verified($identityToken, $tpKeys, $tpProvider);
        } catch (err) {
            webapi.fail($ctx, 401, "the identity token did not verify: " + $err.message);
            return;
        }
    } else {
        # A CI token (8.10) is told apart from a bearer token by its prefix.
        if (citoken.looksLikeToken($presented)) {
            $mode = "ci";
            $ciRec = store.getCiToken($db, token.fingerprint($presented));
            if ($ciRec.fingerprint == "") {
                webapi.unauthorized($ctx, "no such CI token");
                return;
            }
        } else {
            if (not $authOn) {
                webapi.fail($ctx, 501, "this registry accepts no logins, so it accepts no writes");
                return;
            }
            $who = callerOf($ctx);
            if ($who.id == "") {
                webapi.unauthorized($ctx, "a bearer token is required to publish");
                return;
            }
        }
    }

    if (writeThrottled($ctx, publishBudgetKey($ctx, $mode, $who, $ciRec))) {
        return;
    }
    def requestComplaint as string init publishRequestProblem($repository, $tag);
    if (not ($requestComplaint == "")) {
        webapi.fail($ctx, 400, $requestComplaint);
        return;
    }

    def src as publishview.Source;
    try {
        $src = sourceFrom($repository, $tag);
    } catch (err) {
        webapi.fail(
            $ctx,
            502,
            "could not read " + $repository + " at " + $tag +
                ": " + $err.message);
        return;
    }
    # Source authority (7.1 route A) is asked before the lock; publishview judges
    # the answer under it.
    $src.authority = authorityFor($mode, $db, $who, $ciRec, $src);
    # The lock is taken after the forge calls, so a slow forge cannot serialise
    # every write on the server.
    #
    # If the respond timeout already answered `503`, the publish is dropped
    # rather than recorded.
    if (not web.isOpen($ctx)) {
        def why as string init "the forge outlasted the respond timeout; the client got 503";
        audit.write($logSink, audit.publishRefused($why, 503));
        return;
    }
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    # Re-read under the lock: the copy above may be stale.
    $db = store.open($dbPath);

    def now as string init convert.toString(token.now());
    match ($mode) {
        when "trusted" {
            answerPublish(
                $ctx,
                publishview.byTrustedPublisher($db, $claims, $tpAudience, $tpIssuer, $src, $now));
        }
        when "ci" { answerPublish($ctx, publishview.byCiToken($db, $ciRec, $src, $now)); }
        when "token" { answerPublish($ctx, publishview.byToken($db, $who, $src, $now)); }
    }
}

# publishBudgetKey is what a publish counts against: the subject or the CI
# token, once known; the client address for trusted publishing, whose caller is
# a workflow.
func publishBudgetKey(
    ctx as web.Context,
    mode as string,
    who as identity.Subject,
    ciRec as citoken.Token) {
    match ($mode) {
        when "token" { return "subject " + $who.id; }
        when "ci" { return "ci " + $ciRec.fingerprint; }
    }
    return clientKey($ctx);
}

# yankArgs reads the two fields both yank routes take.
func yankArgs(ctx as web.Context) {
    def out as map of string to string init {"name": "", "version": ""};
    try {
        def body as json.Value init json.decode(requestText($ctx));
        if (json.has($body, "/name")) {
            $out["name"] = json.asString($body, "/name");
        }
        if (json.has($body, "/version")) {
            $out["version"] = json.asString($body, "/version");
        }
    } catch (err) {
        return $out;
    }
    return $out;
}

# answerYank runs a yank or an unyank for an authenticated caller.
func answerYank(ctx as web.Context, yanked as bool) {
    if (not $authOn) {
        webapi.fail($ctx, 501, "this registry accepts no logins, so it accepts no writes");
        return;
    }
    def who as identity.Subject init callerOf($ctx);
    if ($who.id == "") {
        webapi.unauthorized($ctx, "a bearer token is required");
        return;
    }
    if (writeThrottled($ctx, "subject " + $who.id)) {
        return;
    }
    def args as map of string to string init yankArgs($ctx);
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    def db as flatdb.DB init store.open($dbPath);
    answerPublish($ctx, publishview.setYanked($db, $who, $args["name"], $args["version"], $yanked));
}

/**
 * POST /yank: withdraw a version from new resolutions (specification 9).
 * @param ctx {web.Context} the request context
 */
func apiYank(ctx as web.Context) {
    answerYank($ctx, true);
}

/**
 * POST /unyank: restore a yanked version (versions are immutable, so a mistaken
 * yank cannot be undone by republishing).
 * @param ctx {web.Context} the request context
 */
func apiUnyank(ctx as web.Context) {
    answerYank($ctx, false);
}

# answerScope sends a ScopeReply, persists, and records what happened.
func answerScope(ctx as web.Context, out as scopeview.ScopeReply) {
    if ($out.changed) {
        store.save($out.db);
    }
    audit.write($logSink, $out.event);
    webapi.sendJson($ctx, $out.status, $out.body);
}

# bodyField reads one string field from a JSON request body, or "".
func bodyField(ctx as web.Context, name as string) {
    try {
        def doc as json.Value init json.decode(requestText($ctx));
        if (json.has($doc, "/" + $name)) {
            return json.asString($doc, "/" + $name);
        }
    } catch (err) {
        return "";
    }
    return "";
}

# bodyFields reads several string members of a JSON body in one decode. A
# missing member, a non-string, or an unreadable body read as "".
func bodyFields(ctx as web.Context, names as list of string) {
    def out as map of string to string init {};
    for (def name in $names) {
        $out[$name] = "";
    }
    try {
        def doc as json.Value init json.decode(requestText($ctx));
        for (def name in $names) {
            if (json.has($doc, "/" + $name) and json.typeOf($doc, "/" + $name) == "string") {
                $out[$name] = json.asString($doc, "/" + $name);
            }
        }
    } catch (err) {
        return $out;
    }
    return $out;
}

/**
 * POST /claim: claim a scope for the authenticated caller (8.2).
 * @param ctx {web.Context} the request context
 */
func apiClaim(ctx as web.Context) {
    def who as identity.Subject init callerOf($ctx);
    if ($who.id == "") {
        webapi.unauthorized($ctx, "a bearer token is required to claim a scope");
        return;
    }
    if (writeThrottled($ctx, "subject " + $who.id)) {
        return;
    }
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    answerScope(
        $ctx,
        scopeview.claim(
            store.open($dbPath),
            $claimPolicy,
            $who,
            bodyField($ctx, "scope"),
            reserved.defaults(),
            convert.toString(token.now())));
}

/**
 * POST /owners: add or remove a co-owner of a scope. `action` is "add" or
 * "remove"; anything else adds, the safer default.
 * @param ctx {web.Context} the request context
 */
func apiOwners(ctx as web.Context) {
    def who as identity.Subject init callerOf($ctx);
    if ($who.id == "") {
        webapi.unauthorized($ctx, "a bearer token is required to change owners");
        return;
    }
    if (writeThrottled($ctx, "subject " + $who.id)) {
        return;
    }
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    answerScope(
        $ctx,
        scopeview.owners(
            store.open($dbPath),
            $who,
            bodyField($ctx, "scope"),
            bodyField($ctx, "subject"),
            not (bodyField($ctx, "action") == "remove"),
            convert.toString(token.now())));
}

/**
 * POST /publishers: register or remove a trusted publisher on a deck or a
 * scope, as the scope's owner (8.9).
 * @param ctx {web.Context} the request context
 */
func apiPublishers(ctx as web.Context) {
    def who as identity.Subject init callerOf($ctx);
    if ($who.id == "") {
        webapi.unauthorized($ctx, "a bearer token is required to change trusted publishers");
        return;
    }
    if (writeThrottled($ctx, "subject " + $who.id)) {
        return;
    }
    def fields as map of string to string init bodyFields(
        $ctx,
        ["target", "action", "provider", "repositoryId", "repository", "workflow", "refs"]);
    def held as store.Lock init lockedStore();
    defer store.unlock($held);
    answerScope(
        $ctx,
        scopeview.publishers(
            store.open($dbPath),
            $who,
            $fields["target"],
            $fields,
            not ($fields["action"] == "remove"),
            convert.toString(token.now())));
}

/**
 * GET /scopes: every registered scope and who holds it. Public, as deck pages
 * already show it.
 * @param ctx {web.Context} the request context
 */
func apiScopes(ctx as web.Context) {
    def out as scopeview.ScopeReply init scopeview.listScopes(sharedStore());
    webapi.sendJson($ctx, $out.status, $out.body);
}

/**
 * GET /health: a liveness check.
 * @param ctx {web.Context} the request context
 */
func apiHealth(ctx as web.Context) {
    def reply as view.Reply init view.health();
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /decks: every deck name in the registry.
 * @param ctx {web.Context} the request context
 */
func apiListDecks(ctx as web.Context) {
    def reply as view.Reply init view.listDecksFrom(sharedIndex(), pageOf($ctx));
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /decks/:name: one deck's full record. Bare names only; a scoped name
 * holds a `/` and must use the query form below.
 * @param ctx {web.Context} the request context
 */
func apiGetDeck(ctx as web.Context) {
    def db as flatdb.DB init sharedStore();
    def name as string init web.param($ctx, "name");
    def reply as view.Reply init view.getDeck($db, $name);
    if ($reply.status == 200) {
        countLookup($name);
    }
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /deck?name=<deck>: one deck's full record, by query parameter. The only
 * route for a scoped name (`@jennifer/routeros`), whose `/` the `/decks/:name`
 * path route would split; the client's resolver uses it.
 * @param ctx {web.Context} the request context
 */
func apiGetDeckByQuery(ctx as web.Context) {
    def db as flatdb.DB init sharedStore();
    def name as string init web.query($ctx, "name");
    def reply as view.Reply init view.getDeck($db, $name);
    if ($reply.status == 200) {
        # Counted only on a hit, so guessed names cannot create counts.
        countLookup($name);
    }
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /decks/:name/:version: one deck version's record.
 * @param ctx {web.Context} the request context
 */
func apiGetVersion(ctx as web.Context) {
    def db as flatdb.DB init sharedStore();
    def name as string init web.param($ctx, "name");
    def reply as view.Reply init view.getVersion($db, $name, web.param($ctx, "version"));
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /resolve?name=<deck>&constraint=<range>: resolve a name and constraint to
 * a fetch URL and its pin.
 * @param ctx {web.Context} the request context
 */
func apiResolve(ctx as web.Context) {
    def db as flatdb.DB init sharedStore();
    def name as string init web.query($ctx, "name");
    def reply as view.Reply init view.resolve($db, $name, web.query($ctx, "constraint"));
    if ($reply.status == 200) {
        countLookup($name);
    }
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

/**
 * GET /resolve-graph?roots=<json>: transitive resolution. `roots` is a JSON
 * object of deck name to constraint; the reply is the flattened, version-locked
 * graph or an error.
 * @param ctx {web.Context} the request context
 */
func apiResolveGraph(ctx as web.Context) {
    if (readThrottled($ctx)) {
        return;
    }
    def db as flatdb.DB init sharedStore();
    def reply as view.Reply init view.resolveGraph($db, web.query($ctx, "roots"));
    webapi.sendJson($ctx, $reply.status, $reply.body);
}

# The versioned surface. Each route is declared once and served under `/v1/...`
# (canonical, declared first so discovery lists it first) and bare `/...`, the
# v1 alias for clients that predate discovery. Routes are `webapi.public()`;
# write handlers authenticate the caller themselves.
#
# Each route carries its specification feature label, from which
# `webapi.discovery` builds the advertised `features`.
def api as webapi.Api init webapi.new();
$api = webapi.mount($api, 1, "/v1");
$api = webapi.alias($api, 1);
$api = webapi.get($api, "/health", apiHealth, webapi.public());
$api = webapi.feature($api, "health");
$api = webapi.get($api, "/decks", apiListDecks, webapi.public());
$api = webapi.feature($api, "decks");
$api = webapi.get($api, "/deck", apiGetDeckByQuery, webapi.public());
$api = webapi.feature($api, "deck");
$api = webapi.get($api, "/decks/:name", apiGetDeck, webapi.public());
$api = webapi.feature($api, "decks");
$api = webapi.get($api, "/decks/:name/:version", apiGetVersion, webapi.public());
$api = webapi.feature($api, "decks");
$api = webapi.get($api, "/resolve", apiResolve, webapi.public());
$api = webapi.feature($api, "resolve");
$api = webapi.get($api, "/resolve-graph", apiResolveGraph, webapi.public());
$api = webapi.feature($api, "resolveGraph");
$api = webapi.get($api, "/search", apiSearch, webapi.public());
$api = webapi.feature($api, "search");
$api = webapi.get($api, "/scopes", apiScopes, webapi.public());
$api = webapi.feature($api, "scopes");

# Claiming and ownership need a logged-in caller, so they are served only when
# logins are configured.
if ($authOn) {
    $api = webapi.post($api, "/claim", apiClaim, webapi.public());
    $api = webapi.feature($api, "claim");
    $api = webapi.post($api, "/owners", apiOwners, webapi.public());
    $api = webapi.feature($api, "owners");
    $api = webapi.post($api, "/publishers", apiPublishers, webapi.public());
    $api = webapi.feature($api, "publishers");
}

# Publishing is always served: CI tokens need no configuration. The handler
# refuses whichever mechanism is not set up.
$api = webapi.post($api, "/publish", apiPublish, webapi.public());
$api = webapi.feature($api, "publish");

# Yanking is a person's decision, so it is served only when logins are
# configured.
if ($authOn) {
    $api = webapi.post($api, "/yank", apiYank, webapi.public());
    $api = webapi.feature($api, "yank");
    $api = webapi.post($api, "/unyank", apiUnyank, webapi.public());
    $api = webapi.feature($api, "yank");
}

# The token exchange, registered only when configured, so discovery advertises
# `auth` only when it works. Public, since these routes are how a caller
# authenticates.
if ($authOn) {
    $api = webapi.post($api, "/auth/device", apiAuthDevice, webapi.public());
    $api = webapi.feature($api, "auth");
    $api = webapi.post($api, "/auth/token", apiAuthToken, webapi.public());
    $api = webapi.feature($api, "auth");
    $api = webapi.post($api, "/auth/refresh", apiAuthRefresh, webapi.public());
    $api = webapi.feature($api, "auth");
}

/**
 * The `webapi` guard as a middleware. A middleware receives only the request, and
 * there are no closures, so this shim supplies `$api`.
 * @param ctx {web.Context} the request context
 * @return {bool} true when the request may run its handler
 */
func apiGuard(ctx as web.Context) {
    return webapi.guard($api, $ctx);
}

# forwardedFor reads the header the deployment configured as carrying the client
# address, or "" when none is configured or the connection did not come from a
# proxy: only a loopback or private peer can be one, and a public peer sending
# the header is a client naming its own address (`throttle.isTrustedPeer`).
func forwardedFor(ctx as web.Context) {
    if ($cfg.clientIpHeader == "" or not throttle.isTrustedPeer(web.remoteAddr($ctx))) {
        return "";
    }
    return web.header($ctx, $cfg.clientIpHeader);
}

/**
 * The access log, as a `before` middleware. Registered ahead of the `webapi`
 * guard so a rejected request is still recorded.
 *
 * It records no status: `web` has no after-handler hook.
 * @param ctx {web.Context} the request context
 * @return {bool} always true; observing a request never refuses it
 */
func accessLog(ctx as web.Context) {
    def ev as audit.Event init audit.requestSeen(
        web.method($ctx),
        web.path($ctx),
        audit.clientOf(forwardedFor($ctx), web.remoteAddr($ctx)));
    if ($logRequests) {
        # Promoted from debug, so the access log does not need debug logging.
        $ev.level = audit.INFO;
    }
    audit.write($logSink, $ev);
    return true;
}

# notModified answers a repeat read of a page or listing with `304` when the
# database has not changed, before anything parses it (`view.isConditional`,
# `view.cacheTag`). `Vary: Accept` goes on every response, since one URL serves
# both HTML and JSON.
func notModified(ctx as web.Context) {
    web.setHeader($ctx, "Vary", "Accept");
    if (not view.isConditional(web.method($ctx), web.path($ctx))) {
        return true;
    }
    def st as fs.Stat;
    try {
        $st = fs.stat($dbPath);
    } catch (err) {
        return true;
    }
    if (web.etag($ctx, view.cacheTag($st.size, $st.mtimeNanos, token.now(), webapi.wants($ctx)))) {
        return false;
    }
    return true;
}

/**
 * GET /.well-known/acme-challenge/...: the HTTP-01 challenge responder, serving
 * the files `certs` wrote. On the plain listener, since HTTP-01 uses port 80.
 *
 * Always registered; it answers 404 when no challenge is pending.
 * @param ctx {web.Context} the request context
 */
func acmeChallenge(ctx as web.Context) {
    # Not `web.serveDir`, which joins the whole request path onto its root. The
    # token goes through `certs.challengePath`, the sanitiser that wrote the file,
    # so it can only address a file inside the challenge directory.
    def token as string init web.param($ctx, "rest");
    if ($token == "") {
        webapi.notFound($ctx, "no challenge token");
        return;
    }
    def path as string init certs.challengePath($cfg.tls, $token);
    if (not fs.exists($path)) {
        webapi.notFound($ctx, "no such challenge is pending");
        return;
    }
    web.serveFile($ctx, $path);
}

/**
 * The handler for a request matching no route.
 *
 * `web` runs middleware only around a handler, so without this the built-in 404
 * would skip the access log. It also answers a browser with a page.
 * @param ctx {web.Context} the request context
 */
func siteNotFound(ctx as web.Context) {
    # A path under an unserved API version gets the version refusal of
    # specification 4.5 instead of a 404.
    def mismatch as view.Reply init view.unsupportedVersion(web.path($ctx), SERVED_APIS);
    if ($mismatch.status > 0) {
        webapi.sendJson($ctx, $mismatch.status, $mismatch.body);
        return;
    }
    if (webapi.wants($ctx) == "html") {
        def page as webview.Page init webview.notFound("No such page: " + web.path($ctx));
        web.html($ctx, $page.status, $page.body);
        return;
    }
    webapi.notFound($ctx, "no such endpoint: " + web.path($ctx));
}

# The Content-Security-Policy for every response except the books, computed once.
# It admits the theme script by hash.
def pagePolicy as string init webview.contentSecurityPolicy();

# securityHeaders sets: no MIME sniffing, no framing (clickjacking), no full URL
# in the Referer, HSTS when TLS is on, and the Content-Security-Policy, so an
# escaping slip has no script to run. The books under /manual, /reference and
# /specs carry grimoire's own scripts, so they get everything but the policy.
func securityHeaders(ctx as web.Context) {
    web.setHeader($ctx, "X-Content-Type-Options", "nosniff");
    web.setHeader($ctx, "X-Frame-Options", "DENY");
    web.setHeader($ctx, "Referrer-Policy", "strict-origin-when-cross-origin");
    if ($cfg.tls.enabled) {
        web.setHeader($ctx, "Strict-Transport-Security", "max-age=31536000");
    }
    def p as string init web.path($ctx);
    for (def book in ["/manual/", "/reference/", "/specs/"]) {
        if (strings.startsWith($p, $book)) {
            return true;
        }
    }
    web.setHeader($ctx, "Content-Security-Policy", $pagePolicy);
    return true;
}

def app as web.App init web.new();
$app = web.before($app, accessLog);
$app = web.before($app, securityHeaders);
$app = web.before($app, notModified);
$app = web.notFound($app, siteNotFound);
$app = webapi.install($api, $app, apiGuard);

# The index and the discovery document are unversioned; the well-known path is
# the one URL a client may hard-code.
$app = web.get($app, "/", apiIndex);
$app = web.get($app, "/.well-known/jennifer-registry", apiDiscovery);

# The website, read-only. Deck pages are under /deck/ because /decks/ belongs to
# the JSON API, where two segments mean name plus version.
$app = web.get($app, "/.well-known/acme-challenge/*rest", acmeChallenge);
$app = web.get($app, "/deck/:scope/:deck", siteDeck);
$app = web.get($app, "/browse", siteBrowse);
$app = web.get($app, "/tags", siteTags);
$app = web.get($app, "/tag/:name", siteTag);
$app = web.get($app, "/scope/:name", siteScope);
$app = web.get($app, "/manual/*rest", siteManual);
$app = web.get($app, "/reference/*rest", siteReference);
$app = web.get($app, "/specs/*rest", siteSpecs);

# The counter flusher, a task so a handler pays only one atomic increment. It
# runs for the life of the process and logs its own failures rather than
# stopping; an idle registry never takes the lock.
def counter as task of int init spawn {
    # Runs for the life of the process.
    while (true) { # lint-disable: L105
        time.sleep(time.fromSeconds(FLUSH_SECONDS));
        try {
            flushCounts();
        } catch (err) { # lint-disable: L103
            audit.write(
                $logSink,
                audit.event("warn", "could not flush resolution counts", {"error": $err.message}));
        }
    }
    return 0;
};

# Listeners. With TLS, a plain listener starts first in a spawned task and the
# certificate is obtained after: HTTP-01 needs the CA to reach port 80, so the
# reverse order deadlocks on a first run. That listener serves only the
# challenge responder, `/health` and a redirect to the TLS origin: the full app
# takes bearer and refresh tokens, which must not travel in clear.
io.printf(
    "jvc deck repository listening on %s (db: %s, log: %s)\n",
    config.displayUrl("http", $addr),
    $dbPath,
    audit.describe($logSink));
audit.write($logSink, audit.serverStarted($addr, $dbPath, $providerName, $authOn));

# Engine limits. `maxInFlight` is a setting because its right value depends on
# database size and host memory, and a publish holds its slot through its forge
# calls. Reads share one parsed store and index (twenty concurrent `/browse`
# measured 0.19 GB). Request bodies are small JSON objects.
def const MAX_BODY_BYTES as int init 65536;
# How long a body may take to arrive before the engine answers `408` (engine
# default 60 s). At 64 KB, ten seconds requires at least 6.5 KB/s.
def const BODY_TIMEOUT_MS as int init 10000;
# Past the respond timeout the engine answers `503` itself, so it must exceed the
# slowest publish (its forge calls).
def limits as httpd.Options init httpd.Options{
    maxBodyBytes: MAX_BODY_BYTES,
    maxInFlight: $cfg.maxInFlight,
    respondTimeoutMs: $cfg.respondTimeoutSeconds * 1000,
    bodyTimeoutMs: BODY_TIMEOUT_MS
};

if (not $cfg.tls.enabled) {
    web.serveOn($app, httpd.listenWith($addr, $limits));
    exit 0;
}

if (config.isStaging($cfg.tls.directory)) {
    io.printf("note: using the ACME staging directory; certificates will not be trusted\n");
}

# httpsOrigin is where the plain listener sends every other request: the first
# certificate name, with the TLS port when it is not 443.
func httpsOrigin() {
    def colon as int init strings.lastIndexOf($cfg.tls.addr, ":");
    def port as string init strings.substring($cfg.tls.addr, $colon + 1, len($cfg.tls.addr));
    def origin as string init "https://" + $cfg.tls.domains[0];
    if (not ($port == "443" or $port == "")) {
        $origin = $origin + ":" + $port;
    }
    return $origin;
}

/**
 * The plain listener's answer to anything but a challenge or a health check
 * when TLS is on: a permanent redirect to the same path on the TLS origin. The
 * query string is not carried (`web` exposes parameters, not the raw string).
 * @param ctx {web.Context} the request context
 */
func toHttps(ctx as web.Context) {
    web.redirect($ctx, 301, httpsOrigin() + web.path($ctx));
}

def plainApp as web.App init web.new();
$plainApp = web.before($plainApp, accessLog);
$plainApp = web.notFound($plainApp, toHttps);
$plainApp = web.get($plainApp, "/.well-known/acme-challenge/*rest", acmeChallenge);
$plainApp = web.get($plainApp, "/health", apiHealth);

def plain as task of int init spawn {
    web.serveOn($plainApp, httpd.listenWith($addr, $limits));
    return 0;
};

def bundle as certs.Bundle;
try {
    $bundle = certs.ensure($cfg.tls, token.now());
} catch (err) {
    io.eprintf(
        "could not obtain a certificate for %s: %s\n",
        strings.join($cfg.tls.domains, ", "),
        $err.message);
    audit.write(
        $logSink,
        audit.certificateFailed(strings.join($cfg.tls.domains, ", "), $err.message));
    # The plain listener keeps answering the challenge and /health, so a restart
    # can retry; it serves nothing else, since the full app would carry
    # credentials in clear.
    io.eprintf("serving only the ACME responder and /health on plain HTTP until restarted\n");
    # Wait on the running listener; starting a second on the same address fails
    # to bind and ends the process.
    task.wait($plain);
    exit 1;
}

audit.write(
    $logSink,
    audit.certificateReady(strings.join($cfg.tls.domains, ", "), $bundle.issuedAt));
io.printf(
    "jvc deck repository listening on %s (%s)\n",
    config.displayUrl("https", $cfg.tls.addr),
    strings.join($cfg.tls.domains, ", "));

def tlsServer as httpd.Server init httpd.listenTLSWith(
    $cfg.tls.addr,
    convert.bytesFromString($bundle.cert, "utf-8"),
    convert.bytesFromString($bundle.key, "utf-8"),
    $limits);
web.serveOn($app, $tlsServer);
