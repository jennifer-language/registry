# Template for .env, which is gitignored. Copy it and fill it in:
#
#     cp .env.example .env

# The GitHub OAuth application's client id. Public by nature: every client that
# runs the device flow sees it. The device grant needs no client secret, so
# there is deliberately no JVC_IDENTITY_SECRET here.
JVC_IDENTITY_CLIENTID=

# The HMAC key the registry signs its OWN bearer tokens with. Nothing to do with
# GitHub. Generated with: openssl rand -hex 32
# Changing it invalidates every outstanding bearer token at once.
JVC_TOKEN_KEY=
