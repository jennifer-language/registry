# The jvc deck registry's configuration.
#
# Copy to config.toml, or point REGISTRY_CONFIG at it. Every key can also be set
# from the environment, and the environment wins: the file describes the
# deployment, the environment varies one instance or injects a secret.
#
# An omitted key keeps its default. An environment variable set to an empty
# string is treated as unset, so a blank in a compose file cannot clear a
# setting configured here. Any variable can also be given as <NAME>_FILE, naming
# a file that holds the value (a mounted secret).

# The registry's public base URL, advertised in the discovery document so a
# client can record where a deck came from. It cannot be detected behind a
# proxy, so it is set here or not at all.
# url = "https://registry.example.com"   # REGISTRY_URL

# The header a trusted proxy puts the real client address in. Unset logs the
# connection's peer, which behind a proxy is the proxy but cannot be forged.
# Name a header only if something in front of the registry sets it and strips
# any copy the client sent; otherwise the audit log records whatever callers
# claim.
#
#   behind Cloudflare (any depth):  CF-Connecting-IP   (Cloudflare overwrites it)
#   behind one proxy alone:         X-Forwarded-For    (last entry is taken)
#
# clientIpHeader = "CF-Connecting-IP"    # REGISTRY_CLIENT_IP_HEADER

# addr = ":8080"                    # REGISTRY_ADDR
# db = "data/decks.json"            # REGISTRY_DB
# Requests handled at once. Reads share one parsed copy of the database and one
# deck index, and listings are paged, so this mostly bounds CPU; see the reference.
# maxInFlight = 32                  # REGISTRY_MAX_IN_FLIGHT
# Seconds a request may take before the server answers 503 itself. Keep it above
# the slowest publish, which waits on several forge calls of up to 10 s each.
# respondTimeout = 120              # REGISTRY_RESPOND_TIMEOUT

# The HMAC key the registry signs its own bearer tokens with. A secret; prefer
# REGISTRY_TOKEN_KEY over writing it here. At least 32 characters; generate with:
# openssl rand -hex 32
# tokenKey = ""                     # REGISTRY_TOKEN_KEY

[log]
# file = ""                         # REGISTRY_LOG        ("" = console only)
# level = "info"                    # REGISTRY_LOG_LEVEL  debug/info/warn/error
# format = "logfmt"                 # REGISTRY_LOG_FORMAT text/logfmt/json (file only)
# requests = false                  # REGISTRY_LOG_REQUESTS one line per request

[identity]
# Who a caller is. With clientId empty the registry accepts no logins, the
# right default for a read-only deployment.
# provider = "github"               # REGISTRY_IDENTITY  github/gitlab/gitea/forgejo/oidc
# clientId = ""                     # REGISTRY_IDENTITY_CLIENTID
# baseUrl = ""                      # REGISTRY_IDENTITY_BASEURL   self-hosted instances
# secret = ""                       # REGISTRY_IDENTITY_SECRET    providers that need one
# scopes = ""                       # REGISTRY_IDENTITY_SCOPES
# Hours a login's organisation memberships stay usable before a refresh is
# refused and the caller must log in again (8.7). 0 turns the check off.
# orgMaxAge = 168                   # REGISTRY_ORG_MAX_AGE

# Who may claim a scope over HTTP.
#   derived     a caller may claim the scope matching their own login (the
#               default, and what the official registry runs)
#   operator    nobody; every scope is granted with deckadmin
#   firstcome   anybody may claim any free name
# policy = "derived"                # REGISTRY_POLICY

[forge]
# Where a publish reads repositories from. Independent of identity above; the
# two coincide only on github.com.
# provider = "github"               # REGISTRY_FORGE
# baseUrl = ""                      # REGISTRY_FORGE_BASEURL
# token = ""                        # REGISTRY_FORGE_TOKEN
# host = ""                         # REGISTRY_FORGE_HOST
# How a publish proves the caller may push to its repository: "login" asks with
# the caller's own provider token (kept sealed), "service" asks with the token
# above about the caller's username. Unset chooses "login" when identity and
# forge are the same service, "service" otherwise.
# sourceAuthority = ""              # REGISTRY_SOURCE_AUTHORITY

[trustedPublishing]
# Publishing from CI with no stored credential (specification 8.9). The audience
# must be specific to this registry (its hostname, for example) so that a token
# minted for another service is refused. Not a secret: the discovery document
# advertises it.
# audience = ""                     # REGISTRY_TRUSTPUB_AUDIENCE  ("" = disabled)
# provider = "github-actions"       # REGISTRY_TRUSTPUB_PROVIDER
# issuer = ""                       # REGISTRY_TRUSTPUB_ISSUER    self-hosted CI

[tls]
# HTTPS with a Let's Encrypt certificate, obtained over the HTTP-01 challenge and
# stored under the data directory. The CA connects to the plain listener on
# port 80, so it must be reachable from the internet and `addr` stays plain HTTP
# rather than redirecting.
#
# enabled = false                   # REGISTRY_TLS
# addr = ":8443"                    # REGISTRY_TLS_ADDR
# domains = ["registry.example.com"] # REGISTRY_TLS_DOMAINS  (comma or space separated)
# email = "ops@example.com"         # REGISTRY_TLS_EMAIL    the CA requires a contact
# agreeTos = false                  # REGISTRY_ACME_AGREE_TOS  must be set deliberately
#
# Use staging until DNS and firewall are right. Staging issues untrusted
# certificates with far higher rate limits; production limits are per registered
# domain per week, and a misconfigured deployment can exhaust them.
# directory = "https://acme-staging-v02.api.letsencrypt.org/directory"
# directory = "https://acme-v02.api.letsencrypt.org/directory"   # REGISTRY_ACME_DIRECTORY
#
# certDir = "data/tls"              # REGISTRY_TLS_CERTDIR
# challengeDir = "data/acme-challenge"  # REGISTRY_ACME_CHALLENGEDIR
# Renewal is checked at startup only, so restart within renewBeforeDays.
# renewBeforeDays = 30              # REGISTRY_TLS_RENEW_BEFORE_DAYS
