# The local interpreter binary (13 MB) - the image takes its own from the
# official base image.
jennifer
jennifer-tiny

# VCS / tooling not needed in the image build context. `*.md` matches only the
# repository root, so reference/*.md and manual/*.md still reach the docs stage, which needs it.
.git
.gitignore
.claude
.editorconfig
*.md

# Runtime state: the registry database lives in a volume, never in the image.
data

# Built documentation. The image builds it in, so the build context must not
# carry a stale copy; see the Dockerfile's grimoire stage.
public

# Local secrets. Compose reads .env on the host and passes the values in as
# environment; it must never be baked into an image layer, where every later
# stage and anyone who pulls the image can read it. The template goes too: the
# image has no use for it either.
.env
.env.example

# Local install / run artifacts.
camcorder.lock
*.tmp
*.log
